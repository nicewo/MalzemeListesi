<Window
    x:Class="MalzemeListesi.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Malzeme Listesi"
    Width="1366"
    Height="768"
    Background="#FF1F1F1F"
    Foreground="White"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="15"
            GlassFrameThickness="0"
            ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="75" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            Grid.Row="0"
            Background="#1E1E1E"
            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  APP TITLE  -->
            <TextBlock
                Margin="12,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Text="Malzeme Listesi" />

            <!--  WINDOW BUTTONS  -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <!--  MINIMIZE  -->
                <Button
                    Width="46"
                    Height="40"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    Click="Minimize_Click"
                    Cursor="Hand"
                    Foreground="White"
                    MouseEnter="Resize_MouseEnter"
                    MouseLeave="Resize_MouseLeave"
                    ToolTip="Küçült">

                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Text="&#xE921;" />
                </Button>

                <!--  MAXIMIZE  -->
                <Button
                    Width="46"
                    Height="40"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    Click="Maximize_Click"
                    Foreground="White"
                    MouseEnter="Resize_MouseEnter"
                    MouseLeave="Resize_MouseLeave"
                    ToolTip="Büyüt">

                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Text="&#xE922;" />
                </Button>

                <!--  CLOSE  -->
                <Button
                    Width="46"
                    Height="40"
                    Background="Transparent"
                    BorderBrush="{x:Null}"
                    Click="Close_Click"
                    Foreground="White"
                    MouseEnter="Close_MouseEnter"
                    MouseLeave="Close_MouseLeave"
                    ToolTip="Kapat">

                    <TextBlock
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="15"
                        Text="&#xE8BB;" />
                </Button>

            </StackPanel>
        </Grid>

        <materialDesign:Card
            Grid.Row="1"
            Margin="10,12,10,12"
            Padding="0">

            <Button
                Width="40"
                Height="40"
                Margin="0,0,10,0"
                Padding="0"
                HorizontalAlignment="Right"
                materialDesign:ButtonAssist.CornerRadius="12"
                Click="Settings_Click"
                ToolTip="Ayarlar">

                <materialDesign:PackIcon
                    Width="30"
                    Height="30"
                    VerticalAlignment="Center"
                    Kind="Settings" />
            </Button>
        </materialDesign:Card>

        <!--  ÜST BAR  -->
        <materialDesign:Card
            Grid.Row="2"
            Margin="10,0,10,12"
            Padding="12">

            <DockPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        Grid.Row="0"
                        Width="518"
                        HorizontalAlignment="Right"
                        materialDesign:HintAssist.Hint="Oluşturulma Tarihi"
                        FontSize="20"
                        FontWeight="SemiBold" />
                    <TextBox
                        Grid.Row="1"
                        Width="518"
                        HorizontalAlignment="Right"
                        materialDesign:HintAssist.Hint="Firma Adı"
                        FontSize="20"
                        FontWeight="SemiBold" />

                </Grid>
            </DockPanel>
        </materialDesign:Card>

        <!--  İÇERİK  -->
        <materialDesign:Card
            Grid.Row="3"
            Margin="10,0,10,12"
            Padding="16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  FORM  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Orientation="Horizontal">
                    <TextBox
                        Width="145"
                        Margin="4"
                        materialDesign:HintAssist.Hint="Marka" />
                    <TextBox
                        Width="159"
                        Margin="4"
                        materialDesign:HintAssist.Hint="Model" />

                    <TextBox
                        Width="461"
                        Margin="4"
                        materialDesign:HintAssist.Hint="Açıklama" />
                    <TextBox
                        Width="72"
                        Margin="4"
                        materialDesign:HintAssist.Hint="Stok" />
                    <TextBox
                        Width="91"
                        Margin="4"
                        materialDesign:HintAssist.Hint="Birim" />
                </StackPanel>


            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
